msgstr "40 grãos colhidos neste capítulo"

msgid "5 nests cleared"
msgstr "5 ninhos eliminados"

msgid "500 copper ahead on the exchange"
msgstr "500 de cobre à frente na troca"

msgid "500 copper more earned on the exchange than spent there"
msgstr "500 de cobre a mais ganhos na troca do que gastos lá"

