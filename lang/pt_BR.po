msgid "10 vegetables a minute"
msgstr "10 vegetais por minuto"

msgid "1500 copper ahead on the exchange"
msgstr "1500 de cobre à frente na troca"

msgid "2 fishing wharves"
msgstr "2 cais de pesca"

msgid "2 wharves, and 30 fish landed"
msgstr "2 cais, e 30 peixes desembarcados"

msgid "20 vegetables"
msgstr "20 vegetais"

msgid "200 wood and 100 stone in store when the storm breaks"
msgstr "200 madeira e 100 pedras em estoque quando a tempestade cair"

msgid "25 commissions fulfilled"
msgstr "25 encomendas atendidas"

msgid "3 breaks ended by comfort()"
msgstr "3 crises encerradas por comfort()"

msgid "3 buildings on spots from free_spot"
msgstr "3 edifícios em locais de free_spot"

