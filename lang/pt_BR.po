msgstr "3 edifícios em locais de free_spot, desempacotados em x, y"

msgid "3 buildings raised from blueprints"
msgstr "3 edifícios erguidos a partir de plantas"

msgid "3 fires out"
msgstr "3 incêndios apagados"

msgid "3 fires out, one of them put out by a hero your handler sent"
msgstr "3 incêndios apagados, um deles apagado por um herói que seu manipulador enviou"

msgid "3 thieves caught"
msgstr "3 ladrões capturados"

msgid "3 thieves caught, the watch on your orders"
msgstr "3 ladrões capturados, a guarda seguindo suas ordens"

msgid "30 fish collected"
msgstr "30 peixes coletados"

msgid "300 copper a minute from the collectors"
msgstr "300 cobre por minuto dos coletores"

msgid "4 new houses"
msgstr "4 casas novas"

msgid "4 new houses, built by a loop over range"
msgstr "4 casas novas, construídas por um laço sobre range"

