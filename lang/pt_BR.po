msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pt_BR\n"
"Language-Name: Português (Brasil)\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid " finished"
msgstr " concluído"

msgid " is locked. Research \""
msgstr " está bloqueado. Pesquisa \""

msgid " is not hired yet."
msgstr " ainda não foi contratado."

msgid " is outside the map "
msgstr " está fora do mapa "

msgid " is taken or off the map."
msgstr " está ocupado ou fora do mapa."

msgid " s"
msgstr " s"

msgid " – 12 s until they strike."
msgstr " – 12 s até atacarem."

msgid " – needs repair"
msgstr " – precisa de reparos"

msgid "\" in the tree."
msgstr "\" na árvore."

msgid "\"3\" + 4 is an error: text and numbers don't mix. Convert first with str(4) or int(\"3\")."
msgstr "\"3\" + 4 é um erro: texto e números não se misturam. Converta antes com str(4) ou int(\"3\")."

msgid "\": "
msgstr "\": "

msgid "\"b3\" and 'b3' are the same string. + joins strings: \"b\" + \"3\" is \"b3\". str(5) turns a number into text, int(\"5\") turns text into a number.\n\nlen(text) counts the characters; in checks for a piece: \"ip\" in \"ripe\" is True.\n\nprint(...) writes several values separated by spaces – the console is the quickest way to look at anything."
msgstr "\"b3\" e 'b3' são a mesma string. + une strings: \"b\" + \"3\" é \"b3\". str(5) transforma um número em texto, int(\"5\") transforma texto em número.\n\nlen(text) conta os caracteres; em verificações de uma peça: \"ip\" in \"ripe\" é True.\n\nprint(...) escreve vários valores separados por espaços — o console é a forma mais rápida de examinar qualquer coisa."

msgid "\"keeping an eye on the well\""
msgstr "\"vigiando o poço\""

msgid "\"{0}\" is not a script name such as \"jobs/upkeep.py\"."
msgstr "\"{0}\" não é um nome de script, como \"jobs/upkeep.py\"."

msgid "\"{0}\" is not a time: \"*/3\" (every 3 minutes), \"@yearly\" or \"@reboot\"."
msgstr "\"{0}\" não é um horário: \"*/3\" (a cada 3 minutos), \"@yearly\" ou \"@reboot\"."

msgid "\"{0}\" is not a trade. Trades: {1}"
msgstr "\"{0}\" não é um ofício. Ofícios: {1}"

msgid "(a // b, a % b) in one go."
msgstr "(a // b, a % b) de uma só vez."

msgid "(market nearby ×2)"
msgstr "(mercado próximo ×2)"

msgid "(or flax)"
msgstr "(ou linho)"

msgid "(or herbs)"
msgstr "(ou ervas)"

msgid "(trial shift)"
msgstr "(turno de teste)"

msgid "({0} against orders)"
msgstr "({0} desobedecendo ordens)"

msgid "({0}, {1}) is new: distance {2}. It joins the back of the queue."
msgstr "({0}, {1}) é novo: distância {2}. Entra no fim da fila."

msgid "+ Hire"
msgstr "+ Contratar"

msgid "+ adds, - subtracts, * multiplies, / divides and always gives a decimal: 7 / 2 is 3.5. // divides and drops the remainder (7 // 2 is 3), % gives the remainder (7 % 2 is 1) – handy for \"every other cell\".\n\nx += 5 is short for x = x + 5 (also -= and *=). Brackets work as in maths: (2 + 3) * 4 is 20.\n\nabs(-3) is 3; min(a, b) and max(a, b) pick the smaller or the bigger value."
msgstr "+ soma, - subtrai, * multiplica, / divide e sempre dá um decimal: 7 / 2 é 3.5. // divide e descarta o resto (7 // 2 é 3), % dá o resto (7 % 2 é 1) — útil para \"a cada outra célula\".\n\nx += 5 é o mesmo que x = x + 5 (também -= e *=). Os parênteses funcionam como na matemática: (2 + 3) * 4 é 20.\n\nabs(-3) é 3; min(a, b) e max(a, b) escolhem o menor ou o maior valor."

msgid "+1 000 of everything"
msgstr "+1 000 de tudo"

msgid "+1 bread from every batch of a bakery, per level (the same grain)."
msgstr "+1 pão de cada lote de uma padaria, por nível (o mesmo grão)."

msgid "+1 iron from every load of a mine, per level."
msgstr "+1 ferro de cada carga de uma mina, por nível."

msgid "+1 knowledge every time a library writes some down, per level."
msgstr "+1 conhecimento sempre que uma biblioteca registra algo, por nível."

msgid "+1 stone from every load of a quarry, per level."
msgstr "+1 Pedra de cada carga de uma Pedreira, por nível."

msgid "+1 tools from every batch of a smithy, per level."
msgstr "+1 ferramentas de cada lote de uma ferraria, por nível."

msgid "+1 wood from every load of a lumberyard, per level."
msgstr "+1 Madeira de cada carga de uma madeireira, por nível."

msgid "+100 of everything"
msgstr "+100 de tudo"

msgid "+2 grain from every harvest, per level."
msgstr "+2 grãos de cada colheita, por nível."

msgid "+{0} {1}"
msgstr "+{0} {1}"

msgid ", line "
msgstr ", linha "

msgid "/ always gives a decimal. Cell coordinates need whole numbers – divide them with //."
msgstr "/ sempre dá um decimal. Coordenadas de célula precisam de números inteiros — divida-as com //."

msgid "/min"
msgstr "/min"

msgid "10 min: low {0:0.0} · high {1:0.0} · their stock {2}"
msgstr "10 min: mínimo {0:0.0} · máximo {1:0.0} · estoque deles {2}"

msgid "14 buildings in town"
msgstr "14 construções na cidade"

msgid "16 tools, with a function that takes parameters"
msgstr "16 ferramentas, com uma função que recebe parâmetros"

msgid "2 programs running at once"
msgstr "2 programas rodando ao mesmo tempo"

msgid "20 successful claim() calls"
msgstr "20 chamadas bem-sucedidas de claim()"

msgid "3 programs running, sharing a module of your own"
msgstr "3 programas rodando, compartilhando um módulo seu"

msgid "3 runs from the crontab"
msgstr "3 execuções a partir do crontab"

msgid "30 iron, with a function that returns an answer"
msgstr "30 ferro, com uma função que retorna uma resposta"

msgid "300 copper a minute, and a loop inside a loop"
msgstr "300 cobre por minuto, e um laço dentro de outro laço"

msgid "4 programs running at once"
msgstr "4 programas rodando ao mesmo tempo"

msgid "6 houses, the program checks money"
msgstr "6 casas, o programa verifica o dinheiro"

msgid "6 knowledge a minute, and a dict that counts"
msgstr "6 conhecimento por minuto, e um dicionário que conta"

msgid "8× is a reward: win {0} trophies (Trophies, %key:Challenges%)."
msgstr "8× é uma recompensa: ganhe {0} troféus (Troféus, %key:Challenges%)."

msgid "8× speed unlocked."
msgstr "Velocidade 8× desbloqueada."

msgid "A 21×21 map"
msgstr "Um mapa 21×21"

msgid "A Builder demolishes while standing next to the building."
msgstr "Um Construtor demole enquanto está ao lado da construção."

msgid "A Builder repairs while standing next to the building."
msgstr "Um Construtor repara enquanto está ao lado da construção."

msgid "A Builder repairs: repair(id). With Menders, warehouse porters patch worn buildings themselves."
msgstr "Um Construtor repara: repair(id). Com Reparadores, os carregadores do armazém consertam sozinhos as construções desgastadas."

msgid "A Collector gathers what homes earn."
msgstr "Um Coletor recolhe o que as casas arrecadam."

msgid "A Collector is needed."
msgstr "É preciso de um Coletor."

msgid "A DataFrame draws itself: df.plot(x=\"time\", y=\"copper\") – and pandas does the sums before."
msgstr "Um DataFrame se desenha sozinho: df.plot(x=\"time\", y=\"copper\") — e o pandas faz as somas antes."

msgid "A DataFrame is a spreadsheet you program. df[\"mood\"] is one column; df.query(\"mood < 50\") keeps the unhappy minutes; df.groupby(\"year\")[\"mood\"].mean() averages each year; df.sort_values(by=\"copper_per_min\", ascending=False) puts the best minutes first, and .head(3) keeps three. df[[\"time\", \"mood\"]] picks several columns.\n\nThe archive has the treasury and the income of every resource, people, homes, births, weddings, deaths, thieves caught and the townsfolk's own copper. With the Town Registry, pd.DataFrame(town.people()) is the whole town as a table, a row a person.\n\nKeyword arguments (by=…, ascending=False) are how library functions take their options."
msgstr "Um DataFrame é uma planilha que você programa. df[\"mood\"] é uma coluna; df.query(\"mood < 50\") mantém os minutos infelizes; df.groupby(\"year\")[\"mood\"].mean() calcula a média de cada ano; df.sort_values(by=\"copper_per_min\", ascending=False) coloca os melhores minutos primeiro, e .head(3) mantém três. df[[\"time\", \"mood\"]] escolhe várias colunas.\n\nO arquivo tem o tesouro e a renda de cada recurso, pessoas, casas, nascimentos, casamentos, mortes, ladrões capturados e o cobre próprio dos moradores. Com o Registro da Cidade, pd.DataFrame(town.people()) é a cidade inteira como tabela, uma linha por pessoa.\n\nArgumentos nomeados (by=…, ascending=False) são a forma como as funções da biblioteca recebem suas opções."

msgid "A Guard arrests someone. A thief or a bribe-taker pays their purse as a fine and returns True; an innocent is let go with apologies (False) and the town grumbles. Clue: purse above earned."
msgstr "Um Guarda prende alguém. Um ladrão ou um subornador paga sua bolsa como multa e retorna True; um inocente é solto com desculpas (False) e a cidade resmunga. Dica: bolsa acima de earned."

msgid "A Guard is needed."
msgstr "É preciso de um Guarda."

msgid "A Python list is a row of boxes; a numpy array is a block of numbers the computer can crunch in one go. houses * 2 doubles every number, houses.sum() and houses.mean() answer at once, and houses > 4 gives a mask of True/False that selects the elements you want: houses[houses > 4].\n\nThis \"vectorised\" style replaces many loops."
msgstr "Uma lista do Python é uma fileira de caixas; um array do numpy é um bloco de números que o computador processa de uma vez. houses * 2 dobra cada número, houses.sum() e houses.mean() respondem na hora, e houses > 4 gera uma máscara de True/False que seleciona os elementos que você quer: houses[houses > 4].\n\nEsse estilo \"vetorizado\" substitui muitos laços."

msgid "A Workers… button on every workplace: who works there and what they made. Place someone at work (12 copper) or let them go; in code town.assign(id, building)."
msgstr "Um botão Trabalhadores… em cada local de trabalho: quem trabalha ali e o que produziu. Coloque alguém para trabalhar (12 cobre) ou dispense-o; em código, town.assign(id, building)."

msgid "A baby boy, {0}, was born to {1} and {2}!"
msgstr "Nasceu um menino, {0}, filho de {1} e {2}!"

msgid "A baby girl, {0}, was born to {1} and {2}!"
msgstr "Nasceu uma menina, {0}, filha de {1} e {2}!"

msgid "A band of {0} bandits is heading for {1}: 12 s until they strike."
msgstr "Um bando de {0} bandidos se dirige a {1}: 12 s até atacarem."

msgid "A bandit"
msgstr "Um bandido"

msgid "A big number on a card, its change with ▲ or ▼, and a little line of its history."
msgstr "Um número grande em um cartão, sua variação com ▲ ou ▼, e uma pequena linha com seu histórico."

msgid "A bountiful year"
msgstr "Um ano farto"

msgid "A bountiful year! For a minute and a half every harvest brings 3 more grain."
msgstr "Um ano farto! Por um minuto e meio, cada colheita traz 3 grãos a mais."

msgid "A bracket is never closed."
msgstr "Um parêntese nunca é fechado."

msgid "A branch named {0} already exists."
msgstr "Já existe um ramo chamado {0}."

msgid "A build plan is a list of [kind, x, y]. Indexes start at 0."
msgstr "Um plano de construção é uma lista de [tipo, x, y]. Os índices começam em 0."

msgid "A building fell to pieces. Where are the heroes with their hammers?"
msgstr "Uma construção desabou. Onde estão os heróis com seus martelos?"

msgid "A building raised from a blueprint"
msgstr "Uma construção erguida a partir de uma planta"

msgid "A burning passion: learns it twice as fast, much happier at it."
msgstr "Uma paixão ardente: aprende duas vezes mais rápido e fica muito mais feliz com isso."

msgid "A camp on the mainland is no place to grow old. Maybe one day…"
msgstr "Um acampamento no continente não é lugar para envelhecer. Quem sabe um dia…"

msgid "A cat costs the treasury {0} copper."
msgstr "Um gato custa {0} cobre do tesouro."

msgid "A cat for a home by the rats"
msgstr "Um gato para uma casa infestada de ratos"

msgid "A cat hunts round its own home. Nests grow, steal grain and bread, spread, and make the neighbours ill."
msgstr "Um gato caça ao redor da própria casa. Ninhos crescem, roubam grãos e pão, se espalham e deixam os vizinhos doentes."

msgid "A cell: skill 0–10, ♥ after their heart. Click it for the priority: 1 first … 4 last, – never."
msgstr "Uma célula: habilidade 0–10, ♥ depois do coração deles. Clique para definir a prioridade: 1 primeiro … 4 último, — nunca."

msgid "A cell: skill 0–10, ♥ after their heart. Priorities come with Work Rosters."
msgstr "Uma célula: habilidade 0–10, ♥ depois do coração deles. As prioridades vêm com as Escalas de Trabalho."

msgid "A chart straight from the table (matplotlib draws it; plt.show() puts it on the desk)."
msgstr "Um gráfico direto da tabela (o matplotlib o desenha; plt.show() o coloca na mesa)."

msgid "A chart with plt.title, plt.xlabel and plt.ylabel"
msgstr "Um gráfico com plt.title, plt.xlabel e plt.ylabel"

msgid "A child from the mainland has a family now. Lovely."
msgstr "Uma criança do continente agora tem família. Que bom."

msgid "A class keeps data and the functions that work on it together: an Order, a Plan, a Route."
msgstr "Uma classe guarda dados e as funções que trabalham com eles juntos: uma Ordem, um Plano, uma Rota."

msgid "A click on a cell in the Work table: 1 first … 4 last, 0 never. ♥ marks a trade they love; they work it faster and happier."
msgstr "Um clique em uma célula da tabela de Trabalho: 1 primeiro … 4 último, 0 nunca. ♥ marca um ofício que eles amam; eles o fazem mais rápido e mais felizes."

msgid "A cohort: one file, many heroes"
msgstr "Uma coorte: um arquivo, muitos heróis"

msgid "A collector: only collecting, round and round."
msgstr "Um coletor: só coleta, sem parar."

msgid "A comet"
msgstr "Um cometa"

msgid "A comet over the island! For a minute and a half every library writes down 3 more knowledge."
msgstr "Um cometa sobre a ilha! Por um minuto e meio, cada biblioteca registra 3 conhecimentos a mais."

msgid "A commit needs a message: git commit -m \"what changed\""
msgstr "Um commit precisa de uma mensagem: git commit -m \"o que mudou\""

msgid "A commit on a branch, then back to main"
msgstr "Um commit em um ramo, depois de volta ao main"

msgid "A complete example solution. Read it, copy it, or write your own first."
msgstr "Uma solução de exemplo completa. Leia, copie ou escreva a sua primeiro."

msgid "A comprehension builds a new list from another one in a single line: what to keep and how to change it."
msgstr "Uma compreensão cria uma nova lista a partir de outra em uma única linha: o que manter e como transformá-lo."

msgid "A copper saved is a copper I keep."
msgstr "Cobre economizado é cobre que eu guardo."

msgid "A copy of the program in use to try something else."
msgstr "Uma cópia do programa em uso para testar outra coisa."

msgid "A creature's brain: the island's own. Nobody may stop it."
msgstr "O cérebro de uma criatura: o da própria ilha. Ninguém pode pará-lo."

msgid "A crow stole my lunch. We're at war now."
msgstr "Um corvo roubou meu almoço. Agora estamos em guerra."

msgid "A dark desk"
msgstr "Uma mesa escura"

msgid "A dashboard in one picture"
msgstr "Um painel em uma imagem"

msgid "A decree issued by a program"
msgstr "Um decreto emitido por um programa"

msgid "A dict finds a value by its name, like a word in a dictionary."
msgstr "Um dict encontra um valor pelo nome, como uma palavra em um dicionário."

msgid "A dict of prices. get_cost(Woodcraft, \"research\") for research."
msgstr "Um dict de preços. get_cost(Woodcraft, \"research\") para pesquisa."

msgid "A dict: kind, x, y, stock, condition, blocked, attacked, enabled, crop (Crop.Empty, Crop.Growing, Crop.Ripe, Crop.Rotten), ripe_in, trees (a lumberyard's groves), deposit (stone left in a quarry's outcrop), name, street, address…"
msgstr "Um dict: kind, x, y, stock, condition, blocked, attacked, enabled, crop (Crop.Empty, Crop.Growing, Crop.Ripe, Crop.Rotten), ripe_in, trees (os bosques de uma madeireira), deposit (pedra restante no afloramento de uma pedreira), name, street, address…"

msgid "A drought"
msgstr "Uma seca"

msgid "A drought! For a minute and a half the fields grow at half speed unless a hero waters them: water(id). Fires catch more easily."
msgstr "Uma seca! Por um minuto e meio, os campos crescem na metade da velocidade, a menos que um herói os regue: water(id). Incêndios começam com mais facilidade."

msgid "A failing line raises an exception: ValueError, KeyError, ZeroDivisionError… Uncaught, it stops the program. try: … except KeyError: … catches one kind, except (KeyError, IndexError) as e: several, and e tells what happened.\n\nelse runs when nothing failed, finally always runs. raise ValueError(\"…\") reports a problem of your own, and class LowStock(Exception): pass makes your own kind.\n\nCatch narrowly: except Exception hides mistakes you would rather see."
msgstr "Uma linha com erro levanta uma exceção: ValueError, KeyError, ZeroDivisionError… Sem tratamento, ela interrompe o programa. try: … except KeyError: … captura um tipo, except (KeyError, IndexError) as e: vários, e e informa o que aconteceu.\n\nelse roda quando nada falhou, finally sempre roda. raise ValueError(\"…\") informa um problema seu, e class LowStock(Exception): pass cria um tipo próprio.\n\nCaptura com precisão: except Exception esconde erros que você preferiria ver."

msgid "A feat of code: the rule is about the programs that run."
msgstr "Uma façanha de código: a regra é sobre os programas em execução."

msgid "A field: plant(id) to sow, harvest(id) when ripe. Ripe grain rots if nobody comes."
msgstr "Um campo: plant(id) para semear, harvest(id) quando estiver maduro. Grãos maduros apodrecem se ninguém vier."

msgid "A fifth of the purses for the treasury"
msgstr "Um quinto das bolsas para o tesouro"

msgid "A fire: douse(id) puts one out, the neighbours bring buckets, the Fire Watch research sends the watchmen."
msgstr "Um incêndio: douse(id) apaga um, os vizinhos trazem baldes, a pesquisa Vigia de Incêndio envia os vigias."

msgid "A first commit"
msgstr "Um primeiro commit"

msgid "A fisher hauls up a treasure."
msgstr "Um pescador puxa um tesouro."

msgid "A fishing wharf must stand on the shore: at the edge of the island."
msgstr "Um cais de pesca precisa ficar na costa: na beira da ilha."

msgid "A fox has its den under the fallen stones."
msgstr "Uma raposa tem sua toca sob as pedras caídas."

msgid "A friendly ghost is wandering the streets. Research Rites and build a Graveyard – a priest from the homes nearby will lay it to rest."
msgstr "Um fantasma amigável vaga pelas ruas. Pesquise Ritos e construa um Cemitério — um padre das casas próximas o fará descansar."

msgid "A function gives a piece of your program a name. Write it once, call it anywhere."
msgstr "Uma função dá um nome a um trecho do seu programa. Escreva-a uma vez, chame-a onde quiser."

msgid "A ghost is waiting for a kind word. I'll see to it."
msgstr "Um fantasma está esperando uma palavra gentil. Eu cuido disso."

msgid "A ghost! I'm sleeping with the candle on tonight."
msgstr "Um fantasma! Vou dormir com a vela acesa esta noite."

msgid "A ghost? I'll have a word with it. Politely."
msgstr "Um fantasma? Vou ter uma conversa com ele. Educadamente."

msgid "A good day's work."
msgstr "Um bom dia de trabalho."

msgid "A grand project finished! The whole town went to look."
msgstr "Um grande projeto concluído! A cidade inteira foi ver."

msgid "A grandparent and a grandchild live in town at the same time."
msgstr "Um avô e um neto vivem na cidade ao mesmo tempo."

msgid "A graveyard for the dead and a priest who lays wandering ghosts to rest."
msgstr "Um cemitério para os mortos e um padre que faz fantasmas errantes descansarem."

msgid "A graveyard is 2×2 and holds 8 graves. free_spot(Graveyard) finds room for it."
msgstr "Um cemitério tem 2×2 e comporta 8 túmulos. free_spot(Graveyard) encontra espaço para ele."

msgid "A graveyard where there is room for one, then back to collecting."
msgstr "Um cemitério onde há espaço para um, depois volta a coletar."

msgid "A guard also protects passively: homes near them are safe."
msgstr "Um guarda também protege passivamente: as casas próximas a ele ficam seguras."

msgid "A guard drives most of them out: defend(\"{0}\")."
msgstr "Um guarda expulsa a maioria deles: defend(\"{0}\")."

msgid "A guard drove bandits from "
msgstr "Um guarda expulsou bandidos de "

msgid "A guard who rests until the town calls: the handler runs the moment bandits appear."
msgstr "Um guarda que descansa até a cidade chamar: o manipulador roda no momento em que os bandidos aparecem."

msgid "A guard: answers threats."
msgstr "Um guarda: responde a ameaças."

msgid "A guardpost on my doorstep. I sleep like a baby."
msgstr "Um posto de guarda na minha porta. Durmo como um bebê."

msgid "A handler of yours answers an event"
msgstr "Um manipulador seu responde a um evento"

msgid "A handler that never returns. The hero's own program waits until it does, so keep handlers short: react, then return."
msgstr "Um manipulador que nunca retorna. O programa do próprio herói espera até que ele retorne, então mantenha os manipuladores curtos: reaja e retorne."

msgid "A headline is coming."
msgstr "Uma manchete está chegando."

msgid "A hero brings an order here with deliver(id); the guild's boats unload here too."
msgstr "Um herói traz uma ordem até aqui com deliver(id); os barcos da guilda também descarregam aqui."

msgid "A hero can be a builder (Builder), a collector (TaxCollector) or a guard (Guard); professions change at the town hall. Up to eight heroes each run a program; several heroes can run one file together (a cohort) and split the work with cohort_index(). One program can also start or watch the others. In the console, h2.build(House, 5, 4) sends a single command to hero 2."
msgstr "Um herói pode ser construtor (Builder), coletor (TaxCollector) ou guarda (Guard); as profissões mudam na prefeitura. Até oito heróis rodam cada um um programa; vários heróis podem rodar um mesmo arquivo juntos (uma coorte) e dividir o trabalho com cohort_index(). Um programa também pode iniciar ou observar os outros. No console, h2.build(House, 5, 4) envia um único comando ao herói 2."

msgid "A hero cannot reassign itself."
msgstr "Um herói não pode reatribuir a si mesmo."

msgid "A hero cannot stop itself – just let the program end."
msgstr "Um herói não pode parar a si mesmo — deixe o programa terminar."

msgid "A hero comforts a townsperson"
msgstr "Um herói consola um morador"

msgid "A hero on guard"
msgstr "Um herói de guarda"

msgid "A hero puts out a fire"
msgstr "Um herói apaga um incêndio"

msgid "A hero's douse(id) puts a fire out; the neighbours bring buckets, the Fire Watch's watchmen run to it."
msgstr "O douse(id) de um herói apaga o fogo; os vizinhos trazem baldes, e os vigias da Vigia de Incêndio correm até lá."

msgid "A histogram: how many values fall into each range."
msgstr "Um histograma: quantos valores caem em cada faixa."

msgid "A in the A/B test: every second shift"
msgstr "A no teste A/B: a cada segundo turno"

msgid "A landmark for a town that runs itself."
msgstr "Um marco para uma cidade que se administra sozinha."

msgid "A law from code. Under every choice the Decrees window prints its line – town.decree(Decree.WatchOn) and the rest. Let a program issue one: a hero carries it to the town hall."
msgstr "Uma lei vinda do código. Sob cada escolha, a janela de Decretos imprime sua linha — town.decree(Decree.WatchOn) e o restante. Deixe um programa emitir um: um herói o leva até a prefeitura."

msgid "A library is ready-made code: one import line and you can use it."
msgstr "Uma biblioteca é código pronto: uma linha de import e você pode usá-la."

msgid "A limit order waits for your price: market.limit_buy(Tools, 5, 9.5, Ambershore) buys only at 9.5 or less."
msgstr "Uma ordem limite espera pelo seu preço: market.limit_buy(Tools, 5, 9.5, Ambershore) compra somente a 9.5 ou menos."

msgid "A line chart. Call it again to add more lines to the same chart."
msgstr "Um gráfico de linhas. Chame de novo para adicionar mais linhas ao mesmo gráfico."

msgid "A line for change over time, bars to compare, dots for places, a histogram for how often, a pie for shares."
msgstr "Uma linha para mudança ao longo do tempo, barras para comparar, pontos para lugares, um histograma para frequência, uma pizza para participações."

msgid "A line on a card (shaded under it); d.lines puts several named lines together."
msgstr "Uma linha em um cartão (sombreada abaixo); d.lines reúne várias linhas nomeadas."

msgid "A list is written [a, b, c]. Indexes start at 0: plan[0] is the first item, len(plan) tells how many there are. append(x) adds to the end, pop() takes the last one off. Lists can hold lists: [[5, 4], [5, 8]].\n\nA dict maps keys to values. inspect(id) returns one, and inspect(id)[\"stock\"] reads a single field."
msgstr "Uma lista é escrita [a, b, c]. Os índices começam em 0: plan[0] é o primeiro item, len(plan) informa quantos há. append(x) adiciona ao fim, pop() retira o último. Listas podem conter listas: [[5, 4], [5, 8]].\n\nUm dict associa chaves a valores. inspect(id) retorna um, e inspect(id)[\"stock\"] lê um único campo."

msgid "A little extra never hurt anyone."
msgstr "Um pouquinho a mais nunca fez mal a ninguém."

msgid "A long lambda. If it needs more than one expression, give it a name with def."
msgstr "Um lambda longo. Se precisar de mais de uma expressão, dê-lhe um nome com def."

msgid "A loop inside a loop covers a whole area: rows × columns."
msgstr "Um laço dentro de outro cobre uma área inteira: linhas × colunas."

msgid "A loop repeats a block so you don't copy lines. while keeps going as long as its condition is true."
msgstr "Um laço repete um bloco para você não copiar linhas. while continua enquanto sua condição for verdadeira."

msgid "A lumberyard cuts the grove around it – one tree per load of wood. Trees regrow slowly, and when the grove is gone the yard stops. replant(id) plants 12 young trees. Teach your loop to look after the forest."
msgstr "Uma madeireira corta o bosque ao redor — uma árvore por carga de madeira. As árvores crescem devagar, e quando o bosque acaba, a madeireira para. replant(id) planta 12 mudas. Ensine seu laço a cuidar da floresta."

msgid "A market only works with homes within 4 cells."
msgstr "Um mercado só funciona com casas a até 4 células."

msgid "A match. Both pointers step inwards."
msgstr "Um confronto. Ambos os ponteiros avançam para dentro."

msgid "A meal with bread and vegetables"
msgstr "Uma refeição com pão e legumes"

msgid "A merchant ship docked at the pier: {0}. It sails in {1} s."
msgstr "Um navio mercante atracou no cais: {0}. Partirá em {1} s."

msgid "A merchant ship is in: it sails in {0} s."
msgstr "Um navio mercante chegou: partirá em {0} s."

msgid "A merge is in progress: finish it with git commit, or git merge --abort."
msgstr "Um merge está em andamento: finalize-o com git commit, ou git merge --abort."

msgid "A minute of 100 copper from the collectors, none from heroes at the homes"
msgstr "Um minuto de 100 cobre dos coletores, nenhum dos heróis nas casas"

msgid "A modest stipend for a modest noble."
msgstr "Um modesto salário para um nobre modesto."

msgid "A module is just another .py file. import tools runs it once and gives you its functions as tools.name."
msgstr "Um módulo é só mais um arquivo .py. import tools o executa uma vez e lhe dá suas funções como tools.name."

msgid "A mood broke. comfort(id) talks someone round; People → Having a hard time shows who is close to it."
msgstr "Um humor quebrou. comfort(id) convence alguém; Pessoas — Passando por dificuldades mostra quem está perto disso."

msgid "A mood broke: someone was unhappy for too long. Their card says why. A hero can comfort(id) them, and food, a market nearby, fair taxes and festivals keep moods up."
msgstr "Um humor quebrou: alguém ficou infeliz por tempo demais. O cartão dele diz o motivo. Um herói pode consolá-lo com comfort(id), e comida, um mercado próximo, impostos justos e festivais mantêm o humor alto."

msgid "A mood that stays low for too long breaks. A hero's comfort(id) ends it; food, a market nearby, fair taxes and festivals prevent it."
msgstr "Um humor que fica baixo por tempo demais quebra. O comfort(id) de um herói o encerra; comida, um mercado próximo, impostos justos e festivais o impedem."

msgid "A moving average: smooths a jumpy line so the trend shows."
msgstr "Uma média móvel: suaviza uma linha irregular para que a tendência apareça."

msgid "A name needs 2 to 14 letters."
msgstr "Um nome precisa ter de 2 a 14 letras."

msgid "A nap is just a very short holiday."
msgstr "Um cochilo é só um feriadinho bem curto."

msgid "A new baby in town! Let's hope this one sleeps."
msgstr "Um novo bebê na cidade! Tomara que este durma."

msgid "A new branch from this commit, and switch to it. git switch -c <name>"
msgstr "Um novo ramo a partir deste commit, e mude para ele. git switch -c <nome>"

msgid "A new commit that undoes this one. git revert {0}"
msgstr "Um novo commit que desfaz este. git revert {0}"

msgid "A new dict from name=value pairs or a list of pairs."
msgstr "Um novo dict a partir de pares nome=valor ou de uma lista de pares."

msgid "A new guardpost! I feel safer already."
msgstr "Um novo posto de guarda! Já me sinto mais seguro."

msgid "A new hero with their own hero_N.py file. Heroes 5–8 join later, when the town grows."
msgstr "Um novo herói com seu próprio arquivo hero_N.py. Os heróis 5–8 entram depois, quando a cidade crescer."

msgid "A new list from anything you can loop over."
msgstr "Uma nova lista a partir de qualquer coisa sobre a qual você possa fazer um laço."

msgid "A new snippet file in snippets/: write the code there. Its name is what you type before Tab."
msgstr "Um novo arquivo de trecho em snippets/: escreva o código ali. Seu nome é o que você digita antes de Tab."

msgid "A new town"
msgstr "Uma nova cidade"

msgid "A number in hexadecimal: '0xff'. bin() and oct() too."
msgstr "Um número em hexadecimal: '0xff'. bin() e oct() também."

msgid "A one-item list is sorted. Two sorted lists merge into one by repeatedly taking the smaller of their front items. The list is halved about log n times, and each level of merging touches every item once."
msgstr "Uma lista de um item já está ordenada. Duas listas ordenadas se unem em uma só, pegando repetidamente o menor dos primeiros itens. A lista é dividida ao meio cerca de log n vezes, e cada nível de junção toca cada item uma vez."

msgid "A one-way stream over items; next(stream) takes the next one."
msgstr "Um fluxo de mão única sobre itens; next(stream) pega o próximo."

msgid "A palindrome reads the same both ways. Instead of building a reversed copy, keep two indexes – left and right – skip anything that isn't a letter, compare, and step both inwards. The first mismatch ends it."
msgstr "Um palíndromo se lê igual nos dois sentidos. Em vez de criar uma cópia invertida, use dois índices — esquerda e direita — pule o que não for letra, compare e avance os dois para dentro. A primeira diferença encerra."

msgid "A part with one item ({0}) is sorted by itself."
msgstr "Uma parte com um item ({0}) já está ordenada por si só."

msgid "A pass without swaps: the list is sorted. Stop early."
msgstr "Uma passagem sem trocas: a lista está ordenada. Pare cedo."

msgid "A pie with many thin slices. Past five or six, bars read better."
msgstr "Uma pizza com muitas fatias finas. Acima de cinco ou seis, barras são mais fáceis de ler."

msgid "A plank here, a nail there: half this town stands on my patches."
msgstr "Uma tábua aqui, um prego ali: metade desta cidade fica de pé graças aos meus remendos."

msgid "A priest lays three ghosts to rest."
msgstr "Um padre faz três fantasmas descansarem."

msgid "A priority is 1 (first) to 4 (last), or 0 for never."
msgstr "A prioridade vai de 1 (primeiro) a 4 (último), ou 0 para nunca."

msgid "A program is a list of instructions that runs from the top down, one at a time, exactly as written."
msgstr "Um programa é uma lista de instruções que roda de cima para baixo, uma por vez, exatamente como escrita."

msgid "A program runs top to bottom."
msgstr "Um programa roda de cima para baixo."

msgid "A program sends a request to an address and gets back a status code and some JSON. In Python this is done with requests.\n\nIn the game the network is closed; pigeons carry the letters instead. https://ironhold.isle/prices answers with the island's prices, /news with its headlines, and your own https://kingdom.isle/census tells about your town. requests.post(\"https://kingdom.isle/board\", json={\"text\": \"…\"}) pins a notice to the town board.\n\nCheck r.status_code before reading: 200 is fine, 404 means no such place, 429 means too many letters – wait as long as r.headers[\"Retry-After\"] says."
msgstr "Um programa envia uma requisição a um endereço e recebe de volta um código de status e algum JSON. Em Python, isso é feito com requests.\n\nNo jogo, a rede está fechada; pombos levam as cartas. https://ironhold.isle/prices responde com os preços da ilha, /news com suas manchetes, e a sua própria https://kingdom.isle/census informa sobre a sua cidade. requests.post(\"https://kingdom.isle/board\", json={\"text\": \"…\"}) fixa um aviso no quadro da cidade.\n\nVerifique r.status_code antes de ler: 200 está ok, 404 significa que não há tal lugar, 429 significa cartas demais — espere pelo tempo que r.headers[\"Retry-After\"] indicar."

msgid "A quarry is 2×2 – find a free 2×2 spot."
msgstr "Uma Pedreira tem 2×2 — encontre um espaço livre 2×2."

msgid "A queue holds at most 1000 items."
msgstr "Uma fila comporta no máximo 1000 itens."

msgid "A queue keeps cells in the order they were found. Take the oldest, give its new neighbours distance + 1 and put them at the back. Since cells come out in order of distance, the first time BFS reaches the goal is along a shortest path; walking back down the distances draws it."
msgstr "Uma fila mantém as células na ordem em que foram encontradas. Pegue a mais antiga, dê a seus novos vizinhos distance + 1 e coloque-os no fim. Como as células saem em ordem de distância, a primeira vez em que o BFS alcança o objetivo é por um caminho mais curto; voltar pelas distâncias desenha esse caminho."

msgid "A quiet beat. I like a quiet beat."
msgstr "Um momento tranquilo. Gosto de um momento tranquilo."

msgid "A quiet place for the town's dead: 8 graves. A priest from the homes nearby lays wandering ghosts to rest here."
msgstr "Um lugar tranquilo para os mortos da cidade: 8 túmulos. Um padre das casas próximas faz os fantasmas errantes descansarem aqui."

msgid "A quiet year"
msgstr "Um ano tranquilo"

msgid "A real trading bot"
msgstr "Um bot de comércio de verdade"

msgid "A reference solution: read it, copy what you need"
msgstr "Uma solução de referência: leia, copie o que precisar"

msgid "A repairer: fixes buildings before they stop. One repair a round, then look again."
msgstr "Um reparador: conserta construções antes que parem. Um reparo por rodada, depois verifique de novo."

msgid "A research list plus an upgrade() loop buys everything for you."
msgstr "Uma lista de pesquisa mais um laço upgrade() compra tudo para você."

msgid "A restless ghost: wanders the town until the priest lays them to rest."
msgstr "Um fantasma inquieto: vaga pela cidade até o padre fazê-lo descansar."

msgid "A risky idea goes on a branch, where the working version is safe. With the research «Branches»: make a branch, change something and commit it there. Then switch back to main: your old code is untouched."
msgstr "Uma ideia arriscada vai para um ramo, onde a versão funcional está segura. Com a pesquisa «Ramos»: crie um ramo, altere algo e faça commit ali. Depois volte ao main: seu código antigo fica intocado."

msgid "A rule of personality: work(me) says how readily someone turns up for work, 0 to 1."
msgstr "Uma regra de personalidade: work(me) diz com que facilidade alguém comparece ao trabalho, de 0 a 1."

msgid "A rule of the personality cannot call anything: it reads the person and answers."
msgstr "Uma regra de personalidade não pode chamar nada: ela lê a pessoa e responde."

msgid "A runaway. Write a program that counts forever and never waits – n = 0, then while True: n += 1 – and start it on a hero. Find it in top: it burns the most CPU. Stop it with kill before the kingdom stops it itself."
msgstr "Um programa descontrolado. Escreva um programa que conta para sempre e nunca espera — n = 0, depois while True: n += 1 — e inicie-o em um herói. Encontre-o em top: ele consome mais CPU. Pare-o com kill antes que o reino o pare por conta própria."

msgid "A sail on the horizon! A ship is coming."
msgstr "Uma vela no horizonte! Um navio está chegando."

msgid "A sail on the horizon. Ship coming."
msgstr "Uma vela no horizonte. Navio chegando."

msgid "A second lumberyard doubles the wood."
msgstr "Uma segunda madeireira dobra a madeira."

msgid "A set: each value once, no order. x in s is instant."
msgstr "Um set: cada valor uma vez, sem ordem. x in s é instantâneo."

msgid "A shift in which tax collectors bring something in"
msgstr "Um turno em que os coletores de impostos trazem algo"

msgid "A shift is a minute. The switch happens when the next one starts."
msgstr "Um turno dura um minuto. A troca acontece quando o próximo começa."

msgid "A ship is in. If the stores have it, it goes down to the pier with me."
msgstr "Um navio chegou. Se os estoques tiverem, eu desço até o cais com ele."

msgid "A ship is on its way."
msgstr "Um navio está a caminho."

msgid "A side story has begun: an optional story with its own characters, in the Story window (%key:Journal%)."
msgstr "Uma história paralela começou: uma história opcional com personagens próprios, na janela História (%key:Journal%)."

msgid "A simple job: change_profession(TaxCollector) and an endless loop collecting everything."
msgstr "Um trabalho simples: change_profession(TaxCollector) e um laço sem fim coletando tudo."

msgid "A single price says little: it wobbles. The average of the last minute (12 prices) is calmer; the average of the last 6 minutes (72 prices) is calmer still. When the short average is above the long one, the price is rising – traders call this a crossover.\n\nWrite the average once as a function and call it with different windows. Lists are 0-based, so the last price is prices[len(prices) - 1].\n\nSeasons are real here: grain and bread swing every five minutes, iron and tools more slowly. An average catches the swing early."
msgstr "Um único preço diz pouco: ele oscila. A média do último minuto (12 preços) é mais calma; a média dos últimos 6 minutos (72 preços) é mais calma ainda. Quando a média curta está acima da longa, o preço está subindo — os comerciantes chamam isso de cruzamento.\n\nEscreva a média uma vez como função e chame-a com janelas diferentes. Listas começam em 0, então o último preço é prices[len(prices) - 1].\n\nAs estações importam aqui: grãos e pão oscilam a cada cinco minutos; ferro e ferramentas, mais devagar. Uma média capta a oscilação cedo."

msgid "A small function without a name (Lambdas, Mastery lane)."
msgstr "Uma pequena função sem nome (Lambdas, Trilha de Maestria)."

msgid "A sorted copy; key says what to sort by."
msgstr "Uma cópia ordenada; key indica por qual critério ordenar."

msgid "A standing order: buy as soon as the average price for that amount is at or below the limit. Returns its ID."
msgstr "Uma ordem permanente: compra assim que o preço médio dessa quantidade estiver igual ou abaixo do limite. Retorna seu ID."

msgid "A standing order: sell as soon as the average price is at or above the limit. Returns its ID."
msgstr "Uma ordem permanente: vende assim que o preço médio estiver igual ou acima do limite. Retorna seu ID."

msgid "A storm"
msgstr "Uma tempestade"

msgid "A storm! Buildings wear twice as fast, and the next ship waits it out at sea."
msgstr "Uma tempestade! As construções se desgastam duas vezes mais rápido, e o próximo navio espera passar no mar."

msgid "A storm! Buildings wear twice as fast, but the Lighthouse brings the ships in."
msgstr "Uma tempestade! As construções se desgastam duas vezes mais rápido, mas o Farol traz os navios para o porto."

msgid "A string is missing its closing quote."
msgstr "Falta a aspa de fechamento de uma string."

msgid "A sunny step. Perfect."
msgstr "Um passo ensolarado. Perfeito."

msgid "A table: named columns of equal length. pd.DataFrame(history()) is the whole royal archive."
msgstr "Uma tabela: colunas nomeadas de mesmo tamanho. pd.DataFrame(history()) é o arquivo real inteiro."

msgid "A tenth of the purses for the treasury"
msgstr "Um décimo das bolsas para o tesouro"

msgid "A trade's shift program: it runs once a minute for every worker. Click: open it."
msgstr "O programa de turno de um ofício: roda uma vez por minuto para cada trabalhador. Clique: abra-o."

msgid "A tuple (3, 4) is a fixed little group, a slice plan[1:3] is part of a list, a set {…} keeps each thing once."
msgstr "Uma tupla (3, 4) é um pequeno grupo fixo, um fatiamento plan[1:3] é parte de uma lista, um set {…} guarda cada coisa uma vez."

msgid "A tuple (a fixed list) from anything you can loop over."
msgstr "Uma tupla (uma lista fixa) a partir de qualquer coisa sobre a qual você possa fazer um laço."

msgid "A twentieth of the purses for the treasury"
msgstr "Um vigésimo das bolsas para o tesouro"

msgid "A value formatted like in an f-string."
msgstr "Um valor formatado como em uma f-string."

msgid "A variable is a labelled box: put a value in once, then use the name everywhere after that."
msgstr "Uma variável é uma caixa rotulada: coloque um valor nela uma vez e use o nome em qualquer lugar depois."

msgid "A variable is a name left of =: home = building_at(3, 4)."
msgstr "Uma variável é um nome à esquerda do =: home = building_at(3, 4)."

msgid "A variable keeps a value under a name. = assigns."
msgstr "Uma variável guarda um valor sob um nome. = atribui."

msgid "A village at last"
msgstr "Uma vila, enfim"

msgid "A wave of rats! Three new nests, by the buildings with the fewest cats about."
msgstr "Uma onda de ratos! Três novos ninhos, perto das construções com menos gatos por perto."

msgid "A wedding needs two people."
msgstr "Um casamento precisa de duas pessoas."

msgid "A wharf needs the shore."
msgstr "Um cais precisa da costa."

msgid "A while loop with a counter runs an exact number of times."
msgstr "Um laço while com contador roda um número exato de vezes."

msgid "A whole field rotted. What a waste of good wheat."
msgstr "Um campo inteiro apodreceu. Que desperdício de bom trigo."

msgid "A whole house to myself. Too quiet some nights."
msgstr "Uma casa inteira só para mim. Silenciosa demais em algumas noites."

msgid "A workplace stops when its stores are full, an input is missing, nobody works there or it burns. survey() gives each one's status."
msgstr "Um local de trabalho para quando seus estoques estão cheios, falta algum insumo, ninguém trabalha ali ou ele pega fogo. survey() informa o status de cada um."

msgid "A/B test: this program and the one in use take turns, shift by shift. Compare them here, or chart the history in code."
msgstr "Teste A/B: este programa e o que está em uso se revezam, turno a turno. Compare-os aqui, ou faça o gráfico do histórico em código."

msgid "A/B test: {0} and {1} take turns, shift by shift."
msgstr "Teste A/B: {0} e {1} se revezam, turno a turno."

msgid "ACTION · takes the hero's time"
msgstr "AÇÃO · consome o tempo do herói"

msgid "ALL TOGETHER"
msgstr "TODOS JUNTOS"

msgid "Abort merge"
msgstr "Cancelar merge"

msgid "About {0} min: {1} comes in at {2} a minute."
msgstr "Cerca de {0} min: {1} entra a {2} por minuto."

msgid "Absolute value."
msgstr "Valor absoluto."

msgid "Actions"
msgstr "Ações"

msgid "Actions need a hero."
msgstr "Ações precisam de um herói."

msgid "Add n (default 1) to a number and return it."
msgstr "Adiciona n (padrão 1) a um número e o retorna."

msgid "Add up a list of numbers"
msgstr "Somar uma lista de números"

msgid "Add up all the numbers in a list."
msgstr "Soma todos os números de uma lista."

msgid "Added to {0}: {1}"
msgstr "Adicionado a {0}: {1}"

msgid "Adds {0}. Your own files are not touched."
msgstr "Adiciona {0}. Seus próprios arquivos não são alterados."

msgid "Admiral Feathers"
msgstr "Almirante Penas"

msgid "Adoption"
msgstr "Adoção"

msgid "Advanced bot"
msgstr "Bot avançado"

msgid "Affects the whole town; every level costs more."
msgstr "Afeta a cidade inteira; cada nível custa mais."

msgid "After their heart: learns it faster, happier at it."
msgstr "Depois do coração deles: aprende mais rápido e fica mais feliz com isso."

msgid "Age"
msgstr "Idade"

msgid "Aldous has kept the royal household for thirty years and has a theory: a town is well run when nobody has to run it. Heroes are splendid, he says, but heroes go off on adventures."
msgstr "Aldous cuida da casa real há trinta anos e tem uma teoria: uma cidade funciona bem quando ninguém precisa administrá-la. Os heróis são esplêndidos, ele diz, mas os heróis saem em aventuras."

msgid "Aldous's test: one minute in which no hero collects from the homes, and the tax collectors still bring the treasury at least 100 copper."
msgstr "Teste de Aldous: um minuto em que nenhum herói coleta das casas, e os coletores de impostos ainda levam ao tesouro pelo menos 100 cobre."

msgid "Aldous, steward of the royal household"
msgstr "Aldous, mordomo da casa real"

msgid "Algorithms"
msgstr "Algoritmos"

msgid "All chapters done"
msgstr "Todos os capítulos concluídos"

msgid "All eight heroes are hired."
msgstr "Todos os oito heróis foram contratados."

msgid "All shop themes"
msgstr "Todos os temas da loja"

msgid "All {0} letters match: return {1}."
msgstr "Todas as {0} letras batem: retorne {1}."

msgid "All {0} tests pass"
msgstr "Todos os {0} testes passaram"

msgid "Allowed"
msgstr "Permitido"

msgid "Already up to date."
msgstr "Já está atualizado."

msgid "Also the trades' shift programs and the creatures' brains, like ps aux."
msgstr "Também os programas de turno dos ofícios e os cérebros das criaturas, como ps aux."

msgid "Also: arrow keys move the camera, Shift moves faster, drag with the left or middle mouse button to pan, right button to rotate, wheel to zoom. F1 reference, F2 hide code windows, Ctrl+S save, Ctrl+B files."
msgstr "Também: as setas movem a câmera, Shift acelera, arraste com o botão esquerdo ou do meio do mouse para deslocar, botão direito para girar, roda para zoom. F1 referência, F2 oculta as janelas de código, Ctrl+S salvar, Ctrl+B arquivos."

msgid "Always day. Click to bring back day and night."
msgstr "Sempre dia. Clique para restaurar o dia e a noite."

msgid "Always open – nothing to unlock."
msgstr "Sempre aberto — nada para desbloquear."

msgid "Ambershore"
msgstr "Ambershore"

msgid "Amount"
msgstr "Quantidade"

msgid "An array of zeros – a grid to fill in, for example the map."
msgstr "Um array de zeros — uma grade para preencher, por exemplo o mapa."

msgid "An array: a block of numbers that does maths on every element at once."
msgstr "Um array: um bloco de números que faz contas em cada elemento de uma vez."

msgid "An empty letter: send json={\"text\": \"…\"}"
msgstr "Uma carta vazia: envie json={\"text\": \"…\"}"

msgid "An endless loop with no actions. Add an action or wait(1) inside the loop."
msgstr "Um laço sem fim sem ações. Adicione uma ação ou wait(1) dentro do laço."

msgid "An except that does nothing. It hides the bug – at least print(e)."
msgstr "Um except que não faz nada. Ele esconde o bug — pelo menos print(e)."

msgid "An extra or mismatched closing bracket."
msgstr "Um parêntese de fechamento a mais ou não correspondente."

msgid "An f-string puts values into text: f\"{name} has {gold} gold\"."
msgstr "Uma f-string coloca valores em um texto: f\"{name} tem {gold} ouro\"."

msgid "An inventor in {0} makes {1} twice as fast."
msgstr "Um inventor em {0} faz {1} duas vezes mais rápido."

msgid "And another thing!"
msgstr "E mais uma coisa!"

msgid "And the nobles live on stipends."
msgstr "E os nobres vivem de salários."

msgid "Announce a rule"
msgstr "Anunciar uma regra"

msgid "Anomaly detection"
msgstr "Detecção de anomalias"

msgid "Another branch already has this commit: make a new commit instead."
msgstr "Outro ramo já tem este commit: faça um novo commit."

msgid "Another cold. My third this year."
msgstr "Mais um resfriado. Meu terceiro este ano."

msgid "Another day at {0}."
msgstr "Mais um dia em {0}."

msgid "Another ghost wandering about. Poor soul."
msgstr "Mais um fantasma vagando por aí. Pobre alma."

msgid "Another lovely stipend. Tea at the market, I think."
msgstr "Mais um belo salário. Chá no mercado, acho."

msgid "Another purse gone. Lock your doors, everyone."
msgstr "Mais uma bolsa sumiu. Tranquem suas portas, pessoal."

msgid "Answers go through answer(value) in any program or the console; what the libraries did is seen by the game itself."
msgstr "As respostas passam por answer(value) em qualquer programa ou no console; o que as bibliotecas fizeram é visto pelo próprio jogo."

msgid "Anvil"
msgstr "Bigorna"

msgid "Anvil Lane"
msgstr "Rua da Bigorna"

msgid "Any .py file is a module: import it and use its functions from other files."
msgstr "Qualquer arquivo .py é um módulo: importe-o e use suas funções em outros arquivos."

msgid "Any field, any choice that is not in force yet. A decree can be changed back at any time."
msgstr "Qualquer campo, qualquer escolha que ainda não esteja em vigor. Um decreto pode ser revertido a qualquer momento."

msgid "Any number of buildings"
msgstr "Qualquer número de construções"

msgid "Any picture to begin with: plt.plot(history(\"population\")) and plt.show(). It appears on your desk."
msgstr "Qualquer imagem para começar: plt.plot(history(\"population\")) e plt.show(). Ela aparece na sua mesa."

msgid "Anyone"
msgstr "Qualquer um"

msgid "Append to a shared queue."
msgstr "Adiciona a uma fila compartilhada."

msgid "Append {0} to the result."
msgstr "Adiciona {0} ao resultado."

