msgid "\"{0}\" from {1} had a bug, and now it is in your scripts. {2}"
msgstr "\"{0}\" de {1} tinha um bug, e agora ele está nos seus scripts. {2}"

msgid "\"{1}\" from {0} was closed unmerged. It was a good change: {2}"
