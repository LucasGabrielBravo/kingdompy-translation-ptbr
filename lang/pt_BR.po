msgstr "Aberto. Execute um programa que o use para dominá-lo."

msgid "Open. The guild is trading – press %key:Guild%."
msgstr "Aberto. A guilda está negociando — pressione %key:Guild%."

msgid "Open. town.* works in every program."
msgstr "Aberto. town.* funciona em todos os programas."

msgid "Opens when the town reaches {0} people."
msgstr "Abre quando a cidade atingir {0} pessoas."

msgid "Opens with «{0}»"
msgstr "Abre com «{0}»"

