msgstr "Abra o bot simples"

msgid "Open the tree (%key:Tree%), pick Desk Themes and press Research – or write upgrade(Themes) in code. Then Menu → Themes → Ink (dark)."
msgstr "Abra a árvore (%key:Tree%), escolha Temas da Mesa e pressione Pesquisar — ou escreva upgrade(Themes) no código. Depois Menu → Temas → Tinta (escuro)."

msgid "Open themes folder"
msgstr "Abrir pasta de temas"

