msgstr "x, y = … em um programa em execução"

msgid "years = comet()\ngaps = [years[i + 1] - years[i] for i in range(len(years) - 1)]\nanswer(sum(gaps) // len(gaps))"
msgstr "years = comet()\ngaps = [years[i + 1] - years[i] for i in range(len(years) - 1)]\nanswer(sum(gaps) // len(gaps))"

msgid "The siege is over: the fleet sails off with {0} home robbed."
msgid_plural "The siege is over: the fleet sails off with {0} homes robbed."
msgstr[0] "O cerco acabou: a frota partiu com {0} casa roubada."
msgstr[1] "O cerco acabou: a frota partiu com {0} casas roubadas."

msgid "{0} hero program is still running."
msgid_plural "{0} hero programs are still running."
msgstr[0] "{0} programa de herói ainda está em execução."
msgstr[1] "{0} programas de herói ainda estão em execução."

msgid "A module is another .py file. import tools runs it once and gives you its functions as tools.name."
msgstr "Um módulo é outro arquivo .py. import tools o executa uma vez e lhe dá suas funções como tools.name."

msgid "A whole year, and the town ran on its people."
msgstr "Um ano inteiro, e a cidade funcionou com o seu povo."

msgid "The homes eat the bread before the market gets any. A second bakery and farm leave some over for goods."
msgstr "As casas comem o pão antes que o mercado receba algum. Uma segunda padaria e uma fazenda deixam sobrar para os bens."

msgid "homes = [id for id in buildings() if inspect(id)[\"kind\"] in [House, Cottage]]\ntarget = max(homes, key=lambda id: inspect(id)[\"copper\"])\nchange_profession(Guard)\ndefend(target)"
msgstr "homes = [id for id in buildings() if inspect(id)[\"kind\"] in [House, Cottage]]\ntarget = max(homes, key=lambda id: inspect(id)[\"copper\"])\nchange_profession(Guard)\ndefend(target)"

msgid "key=lambda id: inspect(id)[\"copper\"] tells max() what to compare: the copper waiting in each home."
msgstr "key=lambda id: inspect(id)[\"copper\"] diz ao max() o que comparar: o cobre esperando em cada casa."

msgid "Every {0} year. The founders sealed something away in a year of the comet."
msgid_plural "Every {0} years. The founders sealed something away in a year of the comet."
msgstr[0] "A cada {0} ano. Os fundadores guardaram algo em um ano do cometa."
msgstr[1] "A cada {0} anos. Os fundadores guardaram algo em um ano do cometa."

msgid "{0} step, and at the end of it a chest with a program in it."
msgid_plural "{0} steps, and at the end of them a chest with a program in it."
msgstr[0] "{0} passo, e no fim dele um baú com um programa dentro."
msgstr[1] "{0} passos, e no fim deles um baú com um programa dentro."

msgid "a district formed"
msgstr "um distrito formado"

msgid "Workers… on a farm's card shows who works it. shifts/farmer.py is the field hands' program: it can say which field comes first."
msgstr "Trabalhadores… na ficha de uma fazenda mostra quem trabalha nela. shifts/farmer.py é o programa dos trabalhadores de campo: ele pode dizer qual campo vem primeiro."

msgid "A bakery, and a fire put out with douse()"
msgstr "Uma padaria, e um incêndio apagado com douse()"

msgid "In your loop:\nfor id in city.buildings_with(Status.Fire):\n    douse(id)"
msgstr "No seu laço:\nfor id in city.buildings_with(Status.Fire):\n    douse(id)"

msgid "a bakery"
msgstr "uma padaria"

msgid "a decree from the town hall"
msgstr "um decreto da prefeitura"

msgid "a fire put out by a hero"
msgstr "um incêndio apagado por um herói"

msgid "Pass the royal inspection"
msgstr "Passe na inspeção real"

msgid "That is not how often the comet comes back. Look at the gaps between the astronomers' years."
msgstr "Não é com que frequência o cometa volta. Olhe as diferenças entre os anos dos astrônomos."

msgid "The inspector leaves content: Lumenport will hear good things about the island."
msgstr "O inspetor vai embora satisfeito: Lumenport ouvirá coisas boas sobre a ilha."

msgid "The main.py window is to the right of the island. Its header has a ▶ button."
msgstr "A janela main.py fica à direita da ilha. Seu cabeçalho tem um botão ▶."

msgid "Workers… on a workplace's card shows the trade's rank and its last shifts."
msgstr "Trabalhadores… na ficha de um local de trabalho mostra o nível do ofício e seus últimos turnos."

msgid "for h in work_history():\n    print(h[\"job\"], h[\"program\"], h[\"made\"])"
msgstr "for h in work_history():\n    print(h[\"job\"], h[\"program\"], h[\"made\"])"

msgid "queue = deque([(sx, sy, 0)])\nseen = {(sx, sy)}\nwhile queue:\n    x, y, d = queue.popleft()\n    if grid[y][x] == \"E\":\n        answer(d)\n        break\n    # … then queue each floor cell next to (x, y) that is not in seen, with d + 1"
msgstr "queue = deque([(sx, sy, 0)])\nseen = {(sx, sy)}\nwhile queue:\n    x, y, d = queue.popleft()\n    if grid[y][x] == \"E\":\n        answer(d)\n        break\n    # … depois enfileire cada célula de chão ao lado de (x, y) que não esteja em seen, com d + 1"

